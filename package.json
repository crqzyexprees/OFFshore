{
  "name": "finance-app",
  "private": false,
  "version": "0.1.0",
  "description": "Local credit card transaction classifier — Python + React",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,vite \"npm run dev:backend\" \"npm run dev:vite\"",
    "dev:backend": ".venv/bin/python -m backend",
    "dev:vite": "vite",
    "app:dev": "tauri dev",
    "app:build": "packaging/build-linux.sh",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
